// Purrdr 後台(ADR-0004、ADR-0007、ADR-0009)。
// 標成 REPLACE_ME 的值上線前要換成真值，清單見 README.md「上線前要填的東西」。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "purrdr-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "purrdr",
      "database_id": "2e93b236-6636-447e-b8e5-22ead8f6909b",
      "migrations_dir": "migrations"
    }
  ],
  // 每個 IP(CF-Connecting-IP)60 秒最多 60 次(#2)。namespace_id 是帳號內唯一的正整數字串;period 只能 10 或 60。
  "ratelimits": [
    { "name": "IP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    // Sign in with Apple 的 client_id:原生 app 就是 bundle id(ID token 的 aud)。
    "APPLE_CLIENT_ID": "com.raychiu.purrdr",
    // Apple Developer Team ID(與 Xcode 專案的 DEVELOPMENT_TEAM 相同)。
    "APPLE_TEAM_ID": "8Z6WVFJ574",
    // Sign in with Apple 私鑰(.p8)的 Key ID。
    "APPLE_KEY_ID": "663SWUGMD9",
    // 接受的 Google OAuth client ID(ID token 的 aud),逗號分隔。iOS 一個，之後 Android 再加。
    "GOOGLE_CLIENT_IDS": "1026000701769-rvh7oog9r0f8svhrf2bvpbqp0vcfskft.apps.googleusercontent.com",
    // 信任的 App Store 簽章根憑證(DER 的 base64,逗號分隔)= Apple Root CA - G3。
    // StoreKit 交易與 App Store Server Notifications 的 JWS 憑證鏈最上層必須跟這裡的某一張逐位元組相同。
    "APPLE_ROOT_CERTIFICATES": "",
    // App Store Connect 的 Apple ID(數字，與 app 的 PurrdrLinks.appStoreID 相同);只檢查 Production 環境的通知。
    "APP_STORE_APP_APPLE_ID": "6835416115",
    // APNs 驗證金鑰(.p8)的 Key ID(推播轉送，#29)。Team ID 沿用 APPLE_TEAM_ID,topic 是 APPLE_CLIENT_ID(bundle id)。
    "APNS_KEY_ID": "663SWUGMD9",
    // App Store Server API 的 In-App Purchase 金鑰(.p8)的 Key ID 與 Issuer ID(#25;App Store Connect → 使用者與存取權限 → 整合 → App 內購買項目)。
    // 兩者都只是識別碼,單獨拿到不能做任何事。上線前換成真值,見 README「上線前要填的東西」。
    "APP_STORE_API_KEY_ID": "REPLACE_ME",
    "APP_STORE_API_ISSUER_ID": "REPLACE_ME",
    // Google Play 串接(#26),全部只是識別碼。上線前換成真值,見 README「Google Play 串接」。
    // Android app 的 package name(Developer API 的 {packageName},RTDN 的 packageName 也要相同)。
    "GOOGLE_PLAY_PACKAGE_NAME": "REPLACE_ME",
    // 呼叫 Developer API 的服務帳戶 email(Play Console 已授權);私鑰是 secret GOOGLE_PLAY_SERVICE_ACCOUNT_KEY。
    "GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL": "REPLACE_ME",
    // Purrdr Plus 在 Google Play 的訂閱商品 ID(subscription product ID),逗號分隔;不在清單內的購買不收。
    "GOOGLE_PLAY_PRODUCT_IDS": "com.raychiu.purrdr.plus.monthly,com.raychiu.purrdr.plus.yearly",
    // RTDN 的 Pub/Sub push subscription 用來簽 OIDC token 的服務帳戶 email(與上面呼叫 API 的可以是不同一個)。
    "GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL": "REPLACE_ME",
    // push subscription 設定的 OIDC audience,建議填通知端點的完整網址。
    "GOOGLE_PLAY_PUBSUB_AUDIENCE": "REPLACE_ME"
  },
  // Secrets:值不寫在這裡，用 `wrangler secret put <名稱>` 設定。
  //   APPLE_PRIVATE_KEY    Sign in with Apple 私鑰 .p8 的 PEM 全文(PKCS#8)
  //   ACCESS_TOKEN_SECRET  簽存取權杖(HS256)的隨機密鑰，至少 32 bytes
  //   APNS_PRIVATE_KEY     APNs 驗證金鑰 .p8 的 PEM 全文(PKCS#8)
  //   APPLE_TOKEN_ENCRYPTION_KEY  加密 Sign in with Apple refresh token 的 AES-GCM 金鑰(base64 的 32 bytes)
  //   APP_STORE_API_KEY    App Store Server API 的 In-App Purchase 金鑰 .p8 的 PEM 全文(PKCS#8)
  //   GOOGLE_PLAY_SERVICE_ACCOUNT_KEY  Google Play Developer API 服務帳戶金鑰:下載的 JSON 金鑰檔全文(或只放 private_key 的 PEM)
  "secrets": { "required": ["APPLE_PRIVATE_KEY", "ACCESS_TOKEN_SECRET", "APNS_PRIVATE_KEY", "APPLE_TOKEN_ENCRYPTION_KEY", "APP_STORE_API_KEY", "GOOGLE_PLAY_SERVICE_ACCOUNT_KEY"] }
}
